<?xml version="1.0"?>
<sdf version="1.6">
  <model name="mower_robot">
    <pose>0 0 0 0 0 0</pose>

    <link name="base_link">
      <inertial>
        <mass>28.0</mass>
        <inertia>
          <ixx>1.10</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>1.65</iyy>
          <iyz>0.0</iyz>
          <izz>2.05</izz>
        </inertia>
      </inertial>
      <collision name="body_collision">
        <pose>0 0 0.08 0 0 0</pose>
        <geometry>
          <box>
            <size>0.9 0.62 0.22</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="body_visual">
        <pose>0 0 0.08 0 0 0</pose>
        <geometry>
          <box>
            <size>0.9 0.62 0.22</size>
          </box>
        </geometry>
        <material>
          <ambient>0.05 0.28 0.12 1</ambient>
          <diffuse>0.05 0.38 0.16 1</diffuse>
          <specular>0.08 0.08 0.08 1</specular>
        </material>
      </visual>
      <visual name="top_cover">
        <pose>0.04 0 0.24 0 0 0</pose>
        <geometry>
          <box>
            <size>0.68 0.48 0.10</size>
          </box>
        </geometry>
        <material>
          <ambient>0.75 0.78 0.72 1</ambient>
          <diffuse>0.75 0.78 0.72 1</diffuse>
        </material>
      </visual>
      <visual name="cutting_disc">
        <pose>-0.05 0 -0.045 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.24</radius>
            <length>0.025</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.14 0.14 0.14 1</ambient>
          <diffuse>0.16 0.16 0.16 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="front_left_wheel">
      <pose>0.32 0.34 -0.02 1.5708 0 0</pose>
      <inertial>
        <mass>1.2</mass>
        <inertia>
          <ixx>0.006</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.006</iyy>
          <iyz>0.0</iyz>
          <izz>0.010</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.02 0.02 0.02 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="front_right_wheel">
      <pose>0.32 -0.34 -0.02 1.5708 0 0</pose>
      <inertial>
        <mass>1.2</mass>
        <inertia>
          <ixx>0.006</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.006</iyy>
          <iyz>0.0</iyz>
          <izz>0.010</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.02 0.02 0.02 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="rear_left_wheel">
      <pose>-0.32 0.34 -0.02 1.5708 0 0</pose>
      <inertial>
        <mass>1.2</mass>
        <inertia>
          <ixx>0.006</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.006</iyy>
          <iyz>0.0</iyz>
          <izz>0.010</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.02 0.02 0.02 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="rear_right_wheel">
      <pose>-0.32 -0.34 -0.02 1.5708 0 0</pose>
      <inertial>
        <mass>1.2</mass>
        <inertia>
          <ixx>0.006</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.006</iyy>
          <iyz>0.0</iyz>
          <izz>0.010</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.02 0.02 0.02 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="front_left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_left_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>
    <joint name="front_right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_right_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
