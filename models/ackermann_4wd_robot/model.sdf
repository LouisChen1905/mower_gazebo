    <link name="rear_right_wheel">
      <pose>-0.36 -0.36 -0.02 0 0 0</pose>
      <inertial>
        <mass>1.6</mass>
        <inertia>
          <ixx>0.008</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.008</iyy>
          <iyz>0.0</iyz>
          <izz>0.012</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0 -1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.5</mu>
              <mu2>1.5</mu2>
