    <link name="front_right_steer_link">
      <pose>0.36 -0.32 0.02 0 0 0</pose>
      <inertial>
        <mass>0.7</mass>
        <inertia>
          <ixx>0.002</ixx>
          <ixy>0.0</ixy>
