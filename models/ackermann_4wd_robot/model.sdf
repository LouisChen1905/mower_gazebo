    <link name="front_left_wheel">
      <pose>0.36 0.36 -0.02 0 0 0</pose>
      <inertial>
        <mass>1.6</mass>
        <inertia>
          <ixx>0.008</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.008</iyy>
          <iyz>0.0</iyz>
