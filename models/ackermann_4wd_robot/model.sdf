    <link name="camera_link">
      <pose>0.48 0.0 0.38 0 0 0</pose>
      <inertial>
        <mass>0.08</mass>
        <inertia>
          <ixx>0.0002</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.0002</iyy>
          <iyz>0.0</iyz>
          <izz>0.0002</izz>
        </inertia>
      </inertial>
      <visual name="camera_housing">
        <geometry>
          <box>
            <size>0.05 0.04 0.03</size>
          </box>
        </geometry>
        <material>
          <ambient>0.10 0.10 0.10 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
        </material>
      </visual>
      <sensor type="ray" name="front_tof">
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <visualize>false</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>100</samples>
              <resolution>1.0</resolution>
              <min_angle>-0.785</min_angle>
              <max_angle>0.785</max_angle>
            </horizontal>
            <vertical>
              <samples>80</samples>
              <resolution>1.0</resolution>
              <min_angle>-0.611</min_angle>
              <max_angle>0.611</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.05</min>
            <max>2.5</max>
            <resolution>0.05</resolution>
          </range>
        </ray>
        <plugin name="front_tof_controller" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <namespace>/mower_tof</namespace>
            <remapping>~/out:=points</remapping>
          </ros>
          <output_type>sensor_msgs/PointCloud2</output_type>
          <frame_name>camera_link</frame_name>
        </plugin>
      </sensor>
    </link>

    <joint name="front_left_steer_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_left_steer_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1.57</lower>
          <upper>1.57</upper>
        </limit>
        <dynamics>
          <damping>0.4</damping>
        </dynamics>
      </axis>
    </joint>
    <joint name="front_right_steer_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_right_steer_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1.57</lower>
          <upper>1.57</upper>
        </limit>
        <dynamics>
          <damping>0.4</damping>
        </dynamics>
      </axis>
    </joint>
    <joint name="front_left_wheel_joint" type="revolute">
      <parent>front_left_steer_link</parent>
      <child>front_left_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>
    <joint name="front_right_wheel_joint" type="revolute">
      <parent>front_right_steer_link</parent>
      <child>front_right_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>
    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>rear_left_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>
    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>rear_right_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>
    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>

    <plugin name="ackermann_4wd_drive" filename="libackermann_4wd_drive_plugin.so">
      <ros>
        <namespace>/</namespace>
      </ros>
      <cmd_vel_topic>cmd_vel</cmd_vel_topic>
      <odom_topic>odom</odom_topic>
      <odom_frame>odom</odom_frame>
      <base_frame>base_link</base_frame>
      <wheel_base>0.72</wheel_base>
      <wheel_track>0.72</wheel_track>
      <wheel_radius>0.12</wheel_radius>
      <rear_axle_to_base>0.36</rear_axle_to_base>
      <max_steer_angle>1.4</max_steer_angle>
      <max_wheel_torque>8.0</max_wheel_torque>
      <max_wheel_acceleration>8.0</max_wheel_acceleration>
      <max_steer_rate>2.0</max_steer_rate>
      <command_timeout>0.3</command_timeout>
      <publish_odom_tf>true</publish_odom_tf>
    </plugin>
  </model>
</sdf>
